{
  "name": "prd-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/env-guard.ts && next dev",
    "build": "node scripts/env-guard.ts && next build",
    "start": "node scripts/env-guard.ts && next start",
    "doctor": "node scripts/doctor.ts",
    "env:local": "node scripts/env-local.ts",
    "db:start": "node scripts/env-guard.ts && supabase start && node scripts/load-notes.ts --local",
    "db:stop": "node scripts/env-guard.ts && supabase stop",
    "db:reset": "node scripts/env-guard.ts && supabase db reset && node scripts/load-notes.ts --local",
    "db:migration": "node scripts/env-guard.ts && supabase db schema declarative sync --no-apply -f",
    "db:types": "node scripts/env-guard.ts && node scripts/db-types.ts",
    "notes:load": "node scripts/env-guard.ts && node scripts/load-notes.ts --local",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node scripts/env-guard.ts && vitest run --project unit",
    "test:integration": "node scripts/env-guard.ts && vitest run --project integration",
    "test:sql": "node scripts/env-guard.ts && supabase test db",
    "test:e2e": "node scripts/env-guard.ts && playwright test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "verify:db": "npm run db:reset && node scripts/db-check.ts && npm run test:sql && npm run test:integration",
    "verify:secrets": "gitleaks git --redact --no-banner --verbose ."
  },
  "dependencies": {
    "@ai-sdk/mistral": "4.0.66",
    "@supabase/supabase-js": "2.118.0",
    "ai": "7.0.143",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
