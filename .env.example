# The app's environment variables. Don't copy this file: `npm run env:local`
# writes .env.local from the running local stack. Hosted values live only in
# the Vercel projects and GitHub environments (see README), never in a file.
# One exception: your own Workers AI account ID and token may sit in
# .env.development.local, for `npm run dev:real` (README, "The real chat
# model on your machine").

# Supabase API address. Local: http://127.0.0.1:57321
SUPABASE_URL=
# The app's read key (sb_publishable_...).
SUPABASE_PUBLISHABLE_KEY=
# The notes loader's write key (sb_secret_...). Server and CI only.
SUPABASE_SECRET_KEY=
# AI adapter: fake on development machines and in CI, cloudflare on staging and production.
AI_PROVIDER=fake
# AI_CHAT_PROVIDER picks the chat model's adapter alone. It isn't a file
# setting: `npm run dev:real` sets it to cloudflare for the dev server.
# Cloudflare Workers AI account ID and token. Hosted: that environment's own.
# Development machine: your own, both in .env.development.local only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# The app's public address. Local: http://localhost:3000
SITE_URL=
# The production domain search engines may index. Unset everywhere until launch.
SITE_INDEXABLE_HOST=
