# The app's environment variables. Don't copy this file: `npm run env:local`
# writes .env.local from the running local stack. Hosted values live only in
# the Vercel projects and GitHub environments (see README), never in a file.

# Supabase API address. Local: http://127.0.0.1:57321
SUPABASE_URL=
# The app's read key (sb_publishable_...).
SUPABASE_PUBLISHABLE_KEY=
# The notes loader's write key (sb_secret_...). Server and CI only.
SUPABASE_SECRET_KEY=
# AI adapter: fake on development machines and in CI, mistral on staging and production.
AI_PROVIDER=fake
# Mistral API key. Never on a development machine.
MISTRAL_API_KEY=
# The app's public address. Local: http://localhost:3000
SITE_URL=
# The production domain search engines may index. Unset everywhere until launch.
SITE_INDEXABLE_HOST=
